{
  "name": "mensalao",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "build:teste": "tsc --noEmit -p tsconfig.json && vite build --mode teste",
    "preview": "vite preview --port 4173 --strictPort",
    "preview:teste": "vite preview --mode teste --port 4173 --strictPort",
    "verificar:bundle": "npm run build && npm run build:teste && node scripts/verificar-provedor-falso.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "capturas": "node scripts/capturas.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.5",
    "typescript": "~5.8",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
